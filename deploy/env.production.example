# PRODUCTION template - contains NO secrets. Provide real values through your
# platform's secret manager / environment settings, never in a committed file.
IIP_ENV=production

# PostgreSQL (TLS recommended: append ?sslmode=require for managed databases).
DATABASE_URL=postgresql+psycopg2://iip_app:CHANGE_ME@db.internal:5432/iip?sslmode=require
IIP_DB_POOL_SIZE=5
IIP_DB_MAX_OVERFLOW=10
IIP_DB_POOL_RECYCLE_S=1800
IIP_DB_STATEMENT_TIMEOUT_MS=60000

# Behind an HTTPS reverse proxy / load balancer that sets X-Forwarded-For
IIP_TRUST_PROXY=true
# Only if the frontend is served from a different origin than the API:
# IIP_CORS_ORIGINS=https://app.example.pk

IIP_ALLOW_REGISTRATION=false
IIP_SESSION_TTL_MIN=480
IIP_PBKDF2_ITERATIONS=600000
IIP_LOGIN_MAX_FAILURES=5
IIP_LOGIN_LOCK_MIN=15
IIP_RATE_LOGIN_PER_MIN=20
IIP_RATE_HEAVY_PER_MIN=30
IIP_MAX_CONCURRENT_HEAVY=2
IIP_MAX_OPT_ITEMS=5000
IIP_MAX_UPLOAD_MB=10
IIP_MAX_UPLOAD_ROWS=100000

IIP_LOG_FORMAT=json
IIP_LOG_LEVEL=INFO
# Error monitoring hook (module:function called with (exc, request_id, path)):
# IIP_ERROR_HOOK=monitoring:capture

WEB_CONCURRENCY=2
IIP_GRACEFUL_S=30
