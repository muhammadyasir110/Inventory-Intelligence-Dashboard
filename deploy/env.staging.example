# STAGING: identical behaviour to production (no demo data, no startup migrations,
# docs disabled, HSTS), separate database and secrets. Use anonymised or synthetic data.
IIP_ENV=staging
DATABASE_URL=postgresql+psycopg2://iip_staging:CHANGE_ME@db-staging.internal:5432/iip_staging
IIP_TRUST_PROXY=true
IIP_ALLOW_REGISTRATION=false
IIP_SESSION_TTL_MIN=480
IIP_LOG_FORMAT=json
WEB_CONCURRENCY=2
