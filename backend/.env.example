# Local DEVELOPMENT settings. Copy to backend/.env and edit. Never commit backend/.env.
# Other environments: deploy/env.test.example, deploy/env.staging.example,
# deploy/env.production.example. Full reference: docs/INSTALL.md.

IIP_ENV=development

# Demo admin password for the seeded `admin` user (development only; default admin123).
# Ignored in staging/production, where no default administrator exists.
# IIP_ADMIN_PASSWORD=

# Browser origins allowed to call the API (only needed if the frontend is served elsewhere).
# IIP_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

IIP_ALLOW_REGISTRATION=false
IIP_SESSION_TTL_MIN=480
IIP_MAX_UPLOAD_MB=10
IIP_MAX_UPLOAD_ROWS=100000
IIP_PBKDF2_ITERATIONS=600000

# Database (default: SQLite file backend/database/iid_local.db)
# DATABASE_URL=postgresql+psycopg2://iip:password@localhost:5432/iip
